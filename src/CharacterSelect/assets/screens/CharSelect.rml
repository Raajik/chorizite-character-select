<rml>
  <head>
    <style>
            body {
              font-family: Tahoma;
              height: 100%;
              width: 100%;
              decorator: image( dat://0x06004d63 );
              z-index: -5000;
            }

            #panel {
              display: block;
              position: absolute;
              top: 206px;
              left: 37px;
              width: 252px;
              padding: 4px;
              height: 300px;
            }

            #panel li {
              display: block;
              position: relative; /* anchor .char-level (absolute) to its row, not the panel */
              height: 42px;
              padding-left: 6px;
              font-size: 14px;
              font-effect: outline(1px black);
            }

            /* Panel content is 292px tall: 42px rows hold 6 characters. With
               more, compact rows keep every row inside the panel art
               (29px x 10 = 290px). */
            #panel li.compact { height: 29px; }
            #panel li.compact .char-name { font-size: 12px; line-height: 15px; }
            #panel li.compact .char-allegiance { font-size: 9px; }
            #panel li.compact .char-level { font-size: 15px; top: 2px; right: 6px; }

            .char-name {
              display: block;
              font-size: 14px;
              line-height: 18px;
              font-effect: outline(1px black);
            }

            .char-allegiance {
              display: block;
              font-size: 11px;
              color: #8ec9e8;
              font-effect: outline(1px black);
            }

            .char-level {
              position: absolute;
              top: 4px;
              right: 8px;
              font-size: 20px;
              font-weight: bold;
              color: #d6a845;
              font-effect: outline(1px black);
            }

            button {
              position: absolute;
              display: inline-block;
              text-align: center;
              width: 100px;
              height: 30px;
              line-height: 30px;
              font-size: 18dp;
              font-effect: outline(2px black);
            }

            button:hover {
              decorator: image( dat://0x06004c9f );
            }

            button#createcharacter {
              color: #ffff00;
              top: 185px;
              left: 315px;
              width: 220px;
              height: 50px;
              line-height: 50px;
              font-size: 21dp;
              font-weight: bold;
            }

            button#enter {
              display: block;
              decorator: image( dat://0x06004CB2 );
              top: 290px;
              left: 340px;
              width: 211px;
              height: 211px;
              line-height: 210px;
              font-size: 32dp;
              font-weight: bold;
            }

            button#enter:hover {
              decorator: image( dat://0x06004CB3 );
            }

            button#delete {
              top: 522px;
              left: 36px;
            }

            button#credits {
              top: 522px;
              left: 465px;
            }

            button#exit {
              top: 522px;
              left: 615px;
            }

            /* Two-line world/population box: name on line 1, population on
               line 2. The box art (dat://0x06004D64, 193x110) is a beveled
               frame: opaque bands at rows 25-30 and 77-82, transparent
               interior rows 31-76 (center y=53.5). The text lines are
               absolutely positioned inside that interior — the previous
               padding-based centering was not reliable and left the name
               touching the top bevel. */
            span#world {
              decorator: image( dat://0x06004D64 );
              display: inline-block;
              width: 250px;
              height: 110px;
              text-align: center;
              position: absolute;
              top: 44px;
              left: 0px;
            }

            .world-name { display: block; position: absolute; top: 35px; left: 0px; right: 0px; font-size: 16px; line-height: 20px; font-effect: outline(1px black); }
            .world-population { display: block; position: absolute; top: 55px; left: 0px; right: 0px; font-size: 13px; color: #d6a845; line-height: 16px; font-effect: none; }

            li:hover { background-color: #ffff0099; }
            li.selected { background-color: yellow; }
            li:active { background-color: red; }
    </style>
    <script type="">
      local rx = require('rx')
      local backend = require('ClientBackend')
      local ui = require('Plugins.RmlUi')
      local ac = require('Plugins.AC').Game
      local csp = require('Plugins.CharacterSelect')
      local GameScreen = CS.AC.Lib.Screens.GameScreen

      local function logDebug(msg)
        print("[CharacterSelect] " .. tostring(msg))
      end

      -- Debug: what does the CS enum resolve to from this script's context?
      logDebug("GameScreen table: " .. tostring(GameScreen))
      local okEnum, charCreateVal = pcall(function() return GameScreen.CharCreate end)
      if okEnum then
        logDebug("GameScreen.CharCreate = " .. tostring(charCreateVal))
      else
        logDebug("GameScreen.CharCreate FAILED: " .. tostring(charCreateVal))
      end


      local state = rx:CreateState({
        SelectedId = 0,
        SelectedName = "",
        ServerName = ac.ServerName,
        Population = "",
        Characters = {}
      })

      -- Format "cur / max" defensively: the C# ints can surface as floats
      -- through XLua (0.0 / 128.0), so strip trailing .0.
      local function fmtInt(v)
        local n = tonumber(v) or 0
        return string.format("%d", n)
      end

      local function updatePopulation()
        state.ServerName = ac.ServerName or ""
        state.Population = fmtInt(ac.CurrentConnectionCount) .. " / " .. fmtInt(ac.MaxAllowedConnections)
      end

      updatePopulation()

      -- Per-character display facts from the plugin's persisted store.
      -- XLua idiom: C# INSTANCE methods are called with COLON syntax
      -- (csp:GetLevel(id) passes the plugin instance as self); dot syntax
      -- (csp.Lookup(id)) tries to convert the number to the plugin object
      -- and errors — the pcall swallowed that, so rows always showed
      -- "Level ?" even when the store had the data. Try primitives first,
      -- then the JSON blob with a properly-required json module (the old
      -- code shadowed the module with the JSON string and decoded the
      -- string itself, which can never work).
      local okJson, jsonlib = pcall(require, 'json')

      local function callInstance(fnName, id)
        local ok, res = pcall(function() return csp[fnName](csp, id) end)
        if ok then return res end
        ok, res = pcall(function() return csp[fnName](id) end)
        if ok then return res end
        return nil
      end

      local function factsFor(id)
        local lvl = callInstance('GetLevel', id)
        if type(lvl) == 'number' then
          local alg = callInstance('GetAllegiance', id) or ''
          if type(alg) ~= 'string' then alg = tostring(alg or '') end
          return { Level = lvl, Allegiance = alg }
        end

        -- Fallback: JSON blob via Lookup, decoded with the json module.
        local raw = callInstance('Lookup', id)
        if okJson and type(raw) == 'string' and #raw > 0 then
          local okDecode, decoded = pcall(jsonlib.decode, raw)
          if okDecode and type(decoded) == 'table' then return decoded end
        end
        return nil
      end

      local function UpdateCharacters()
        local list = {}
        for i, v in pairs(ac.Characters) do
          local facts = factsFor(v.Id) or {}
          table.insert(list, {
            Id = v.Id,
            Name = v.Name,
            Level = facts.Level or 0,
            Allegiance = facts.Allegiance or ""
          })
        end
        state.Characters = list
        if #list > 0 then
          state.SelectedId = list[1].Id
          state.SelectedName = list[1].Name
        end
        for i, k in ipairs(list) do
          logDebug("row " .. k.Name .. " id=" .. tostring(k.Id) .. " level=" .. tostring(k.Level) .. " allegiance='" .. tostring(k.Allegiance) .. "'")
        end
        logDebug("characters: " .. #list)
      end

      UpdateCharacters()

      logDebug("screen loaded; characters known to client: " .. #state.Characters)

      ac:OnWorldInfo('+', function()
        updatePopulation()
        logDebug("world info: " .. tostring(state.ServerName) .. " " .. tostring(state.Population))
      end)

      ac:OnCharactersChanged('+', UpdateCharacters)

      local function CharacterRow(char)
        -- Rows anchor .char-level via position:relative; rows beyond 6 use
        -- the compact class so every row fits inside the panel art.
        local compact = #state.Characters > 6
        local levelLabel = "Level ?"
        if char.Level ~= nil and char.Level > 0 then
          -- XLua numbers surface as floats (0.0/1.0); tostring would render
          -- "1.0", so format through %d.
          levelLabel = string.format("%d", char.Level)
        end
        local allegianceText = ""
        if char.Allegiance ~= nil and #char.Allegiance > 0 then
          allegianceText = "<" .. char.Allegiance .. ">"
        end
        return rx:Li({
          class = { selected = state.SelectedId == char.Id, compact = compact },
          onclick = function()
            state.SelectedId = char.Id
            state.SelectedName = char.Name
          end
        }, {
          rx:Span(char.Name, { class = "char-name" }),
          rx:Span(allegianceText, { class = "char-allegiance" }),
          rx:Span(levelLabel, { class = { ["char-level"] = true, unknown = (char.Level or 0) == 0 } })
        })
      end

      local CharacterSelectView = function(state)
        local rows = {}
        for i, k in ipairs(state.Characters) do
          table.insert(rows, CharacterRow(k))
        end
        return rx:Div({ class="wrapper" }, {
          rx:Span({ id="world" }, {
            rx:Span(state.ServerName, { class = "world-name" }),
            rx:Span("Population: " .. (state.Population or ""), { class = "world-population" })
          }),
          rx:Button({ id="exit", onclick = function(evt)
            ui.PanelManager:ShowModalConfirmation("Are you sure you want to exit?", function(res)
              if res == "Yes" then
                backend:Exit()
              end
            end, "Yes", "No")
          end }, "EXIT"),
          rx:Button({ id="enter", onclick = function(evt)
            if state.SelectedId ~= 0 then
              ac:Login(state.SelectedId)
            end
          end }, "ENTER"),
          rx:Button({ id="createcharacter", onclick = function(evt)
            -- XLua fails to cast GameScreen.CharCreate by value in some
            -- contexts ("invalid value for enum"); the numeric value works.
            local okSet, err = pcall(function() ac:SetScreen(GameScreen.CharCreate) end)
            if not okSet then
              logDebug("SetScreen(CharCreate) failed: " .. tostring(err) .. "; retrying with raw value")
              pcall(function() ac:SetScreen(268435467) end)
            end
          end }, "Create Character"),
          rx:Button({ id="credits", onclick = function(evt) ac:SetScreen(GameScreen.Credits) end }, "CREDITS"),
          rx:Button({ id="delete", disabled="disabled", onclick = function(evt) print("DELETE!!") end }, "DELETE"),
          rx:Div({ id="panel" },
            rx:Ul({}, function()
              local children = {}
              for i, k in ipairs(state.Characters) do
                table.insert(children, CharacterRow(k))
              end
              return children
            end)
          )
        })
      end

      document:Mount(function() return CharacterSelectView(state) end, "#characterselect")
    </script>
  </head>
  <body>
    <div id="characterselect"></div>
  </body>
</rml>
